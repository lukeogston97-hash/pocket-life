// Pocket Life server, deployed by Cloudflare from this folder on every push to main.
{
  "name": "pocket-life",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "WORLD", "class_name": "World" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["World"] }]
}
